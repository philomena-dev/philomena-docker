# Settings of the proxy server of a Philomena deployment.
#
# `./philomena.sh prepare` creates this file from the bundle made on the app
# server. There is normally nothing to fill in here.
#
# The file is read by Docker Compose. Wrap a value in 'single quotes' if it
# contains a $, a #, quotes or spaces.

CONFIG_VERSION=1

ROLE=proxy
COMPOSE_FILE=docker-compose.edge.yml:docker-compose.link-proxy.yml

## Domains

SITE_DOMAIN=
CDN_DOMAIN=
EXT_DOMAIN=

## Link to the app server

# Address of the app server, as reachable from this server.
ORIGIN_URL=
SCRAPER_LINK_PORT=3129

# The address of this server inside the WireGuard tunnel, which is the only
# one the port above is published on. Without it, the port is published on
# every address of this server, which is not recommended.
#SCRAPER_LINK_BIND=

## Secrets

CAMO_KEY=

## Object storage
#
# Read access to the bucket of uploaded files, which this server serves on
# the CDN domain. With CDN_SOURCE=origin the files are requested from the app
# server instead, and the storage settings are not used.

CDN_SOURCE=storage
S3_SCHEME=
S3_HOST=
S3_PORT=
S3_REGION=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

## Public certificate
#
# Directory that `./philomena.sh cert install` copies fullchain.pem and
# privkey.pem from. Empty when a self-signed certificate is used.
TLS_CERT_PATH=

## Visitors
#
# How the address of a visitor is determined: `direct` when visitors connect
# to this server directly, `cloudflare` when the domains are proxied by
# Cloudflare. See config/nginx/realip for other setups.
CLIENT_IP_SOURCE=direct

## Resources

# Disk space the CDN cache may use.
CDN_CACHE_SIZE=8g
