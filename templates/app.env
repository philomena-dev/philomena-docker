# Settings of this Philomena deployment.
#
# `./philomena.sh prepare` creates this file. Fill in every value that reads
# CHANGE_THIS, then run `./philomena.sh check`.
#
# The file is read by Docker Compose. Wrap a value in 'single quotes' if it
# contains a $, a #, quotes or spaces.
#
# Keep a copy of this file somewhere safe. The site cannot be restored from a
# backup without the secrets in it.

CONFIG_VERSION=1

# What this server does: `single` runs everything, `app` runs the application
# behind a separate proxy server.
ROLE=
COMPOSE_FILE=
COMPOSE_PROFILES=

# Owner of the files written to ./backups.
HOST_UID=
HOST_GID=

## Domains

SITE_DOMAIN=
CDN_DOMAIN=
EXT_DOMAIN=

## Secrets
#
# Generated by `prepare`. Changing them on a live site logs everyone out,
# invalidates passwords and two-factor setups, and renames anonymous posters.

SECRET_KEY_BASE=
ANONYMOUS_NAME_SALT=
PASSWORD_PEPPER=
OTP_SECRET_KEY=
CAMO_KEY=
POSTGRES_PASSWORD=

## Outgoing mail

SMTP_RELAY=CHANGE_THIS
SMTP_PORT=587
SMTP_USERNAME=CHANGE_THIS
SMTP_PASSWORD=CHANGE_THIS
MAILER_ADDRESS=

## External services

HCAPTCHA_SITE_KEY=CHANGE_THIS
HCAPTCHA_SECRET_KEY=CHANGE_THIS
TUMBLR_API_KEY=CHANGE_THIS

## Object storage
#
# Where uploaded files are kept. For services that do not use regions, such
# as Cloudflare R2, set S3_REGION to `auto`.

S3_SCHEME=CHANGE_THIS
S3_HOST=CHANGE_THIS
S3_PORT=CHANGE_THIS
S3_REGION=CHANGE_THIS
S3_BUCKET=CHANGE_THIS
AWS_ACCESS_KEY_ID=CHANGE_THIS
AWS_SECRET_ACCESS_KEY=CHANGE_THIS

# Optional: separate credentials for the web servers, which only ever read.
# Without these, the credentials above are used.
#WEB_AWS_ACCESS_KEY_ID=
#WEB_AWS_SECRET_ACCESS_KEY=

# Optional: a second bucket, at a different provider, that every upload is
# copied to. Set all of these or none.
#ALT_S3_SCHEME=
#ALT_S3_HOST=
#ALT_S3_PORT=
#ALT_S3_REGION=
#ALT_S3_BUCKET=
#ALT_AWS_ACCESS_KEY_ID=
#ALT_AWS_SECRET_ACCESS_KEY=

## Public certificate
#
# Directory that `./philomena.sh cert install` copies fullchain.pem and
# privkey.pem from. Empty when a self-signed certificate is used.
TLS_CERT_PATH=

## Visitors
#
# How the address of a visitor is determined: `direct` when visitors connect
# to this deployment directly, `cloudflare` when the domains are proxied by
# Cloudflare. See config/nginx/realip for other setups. With a separate proxy
# server, this is set on the proxy server instead.
CLIENT_IP_SOURCE=direct

## Resources

# Memory given to the search engine. A quarter of the server's memory is a
# good value; do not go above half.
OPENSEARCH_HEAP=4g

# Database connections opened by each application process.
POOL_SIZE=20

# Disk space the CDN cache may use.
CDN_CACHE_SIZE=8g

## Schedule (hours are in UTC)

# Hour of the day at which the daily maintenance jobs run.
CRON_DAILY_HOUR=8

# Hour of the day at which the database is backed up to ./backups, and the
# number of days backups are kept.
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
