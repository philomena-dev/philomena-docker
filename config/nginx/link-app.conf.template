# App server end of the link to the proxy server.
#
# entrypoint.sh renders this file when the container starts, replacing the
# ${UPPER_CASE} placeholders with values from the environment. nginx's own
# $variables are left alone.

worker_processes auto;
worker_rlimit_nofile 65536;
pid /run/nginx.pid;
error_log /dev/stderr warn;

events {
  worker_connections 16384;
}

# Requests the proxy server relays for the site and the CDN.
http {
  server_tokens off;

  log_format main '$remote_addr - [$time_local] "$host" "$request" $status '
                  '$body_bytes_sent $request_time';
  access_log /dev/stdout main;

  resolver 127.0.0.11 valid=10s ipv6=off;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' '';
  }

  server {
    listen 8443 ssl;

    ssl_certificate /etc/philomena-certs/internal/origin.pem;
    ssl_certificate_key /etc/philomena-certs/internal/origin-key.pem;
    ssl_client_certificate /etc/philomena-certs/internal/ca.pem;
    ssl_verify_client on;
    ssl_verify_depth 1;
    ssl_protocols TLSv1.3;
    ssl_session_cache shared:tls:10m;
    ssl_session_timeout 1d;

    # Only the proxy server can complete the handshake above, so the visitor
    # address it reports is taken as is.
    set_real_ip_from 0.0.0.0/0;
    real_ip_header X-Forwarded-For;

    # The proxy server has already buffered and size-checked the request.
    client_max_body_size 130m;
    proxy_request_buffering off;
    proxy_buffering off;

    location / {
      set $caddy http://caddy:80;
      proxy_pass $caddy;

      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header CF-Connecting-IP '';
      proxy_read_timeout 5m;
      proxy_send_timeout 5m;
    }
  }

  server {
    listen 127.0.0.1:8080;

    location = /nginx-health {
      access_log off;
      return 204;
    }
  }
}

# Connections the scraper makes to its outgoing proxy, which runs on the
# proxy server. The application talks plain HTTP to port 3128 here.
stream {
  resolver 127.0.0.11 valid=10s ipv6=off;

  server {
    listen 3128;

    set $scraper_proxy ${PROXY_SERVER}:${SCRAPER_LINK_PORT};
    proxy_pass $scraper_proxy;

    proxy_ssl on;
    proxy_ssl_certificate /etc/philomena-certs/internal/origin.pem;
    proxy_ssl_certificate_key /etc/philomena-certs/internal/origin-key.pem;
    proxy_ssl_trusted_certificate /etc/philomena-certs/internal/ca.pem;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 1;
    proxy_ssl_name edge.internal;
    proxy_ssl_server_name on;
    proxy_ssl_protocols TLSv1.3;
  }
}
